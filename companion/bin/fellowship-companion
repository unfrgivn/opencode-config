#!/usr/bin/env node

import { spawn } from "node:child_process"
import * as fs from "node:fs"
import * as os from "node:os"
import * as path from "node:path"
import { fileURLToPath } from "node:url"

const VERSION = 1
const DEFAULT_POLL_MS = 1000
const MIN_POLL_MS = 250
const MAX_POLL_MS = 4000
const ART_FRAME_COUNT = 4
const ART_FRAME_WIDTH = 128
const ART_FRAME_HEIGHT = 160

function getStorageDir() {
  const xdg = process.env.XDG_DATA_HOME?.trim()
  const base = xdg && path.isAbsolute(xdg) ? xdg : path.join(os.homedir(), ".local", "share")
  return path.join(base, "opencode", "storage", "fellowship")
}

const statePath = process.env.FELLOWSHIP_COMPANION_STATE_PATH || path.join(getStorageDir(), "opencode-config.companion-state.json")
const storageDir = path.dirname(statePath)
const runtimePath = path.join(storageDir, "opencode-config.companion-runtime.json")
const logPath = path.join(storageDir, "opencode-config.companion.log")
const overlayPidPath = path.join(storageDir, "opencode-config.companion-overlay.pid")
const artBasePath = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "art")
const overlayPath = path.join(path.dirname(fileURLToPath(import.meta.url)), "fellowship-companion-overlay-macos.jxa")
const overlayProcessName = "opencode-companion-overlay"
const startedAt = new Date().toISOString()
const launcherSessionID = process.env.FELLOWSHIP_COMPANION_SESSION_ID || null
const debugEnabled = process.env.FELLOWSHIP_COMPANION_DEBUG === "1"
const overlayDisabled = process.env.FELLOWSHIP_COMPANION_DISABLE_OVERLAY === "1"

const agentNameTable = [
  { canonical: "orchestrator", role: "orchestrator", descriptive: "orchestrator", lotr: "gandalf" },
  { canonical: "explorer", role: "explorer", descriptive: "explorer", lotr: "legolas" },
  { canonical: "researcher", role: "researcher", descriptive: "researcher", lotr: "radagast" },
  { canonical: "planner", role: "planner", descriptive: "planner", lotr: "treebeard" },
  { canonical: "implementer", role: "implementer", descriptive: "implementer", lotr: "celebrimbor" },
  { canonical: "architect", role: "architect", descriptive: "architect", lotr: "elrond" },
  { canonical: "analyst", role: "analyst", descriptive: "analyst", lotr: "galadriel" },
  { canonical: "tdd", role: "tdd", descriptive: "tdd", lotr: "aragorn" },
]

let lastSummaryKey = ""
let lastStatus = ""
let notificationInFlight = false
let overlayProcess = null
let lastOverlayLaunchAt = 0

function appendLog(message) {
  try {
    fs.mkdirSync(storageDir, { recursive: true })
    fs.appendFileSync(logPath, `${new Date().toISOString()} ${message}\n`)
  } catch (err) {
    console.error(`[fellowship-companion] ${err instanceof Error ? err.message : String(err)}`)
  }
}

function readJson(filePath) {
  try {
    return JSON.parse(fs.readFileSync(filePath, "utf8"))
  } catch (err) {
    if (err && typeof err === "object" && "code" in err && err.code === "ENOENT") return null
    appendLog(`read failed: ${err instanceof Error ? err.message : String(err)}`)
    return null
  }
}

function uniqueStrings(values) {
  return [...new Set(values.filter((value) => typeof value === "string" && value.trim().length > 0).map((value) => value.trim()))]
}

function normalizeTheme(value) {
  return value === "lotr" ? "lotr" : "descriptive"
}

function formatAgent(agentName, theme) {
  const trimmed = typeof agentName === "string" ? agentName.trim() : ""
  if (trimmed === "intro" || trimmed === "input") {
    return {
      key: trimmed,
      role: trimmed,
      canonical: trimmed,
      display_name: trimmed,
      theme,
      art_key: `common/${trimmed}`,
      art_path: path.join(artBasePath, "common", `${trimmed}.svg`),
      art_frame_count: ART_FRAME_COUNT,
      art_frame_width: ART_FRAME_WIDTH,
      art_frame_height: ART_FRAME_HEIGHT,
    }
  }

  const entry = agentNameTable.find((item) => item.canonical === trimmed || item.descriptive === trimmed || item.lotr === trimmed)
  if (!entry) {
    return {
      key: trimmed,
      role: null,
      canonical: null,
      display_name: trimmed,
      theme,
      art_key: "common/unknown",
      art_path: path.join(artBasePath, "common", "unknown.svg"),
      art_frame_count: ART_FRAME_COUNT,
      art_frame_width: ART_FRAME_WIDTH,
      art_frame_height: ART_FRAME_HEIGHT,
    }
  }

  const displayName = entry[theme]
  return {
    key: displayName,
    role: entry.role,
    canonical: entry.canonical,
    display_name: displayName,
    theme,
    art_key: `${theme}/${displayName}`,
    art_path: path.join(artBasePath, theme, `${displayName}.svg`),
    art_frame_count: ART_FRAME_COUNT,
    art_frame_width: ART_FRAME_WIDTH,
    art_frame_height: ART_FRAME_HEIGHT,
  }
}

function sessionAgentDetails(session, theme) {
  if (Array.isArray(session?.active_agent_details) && session.active_agent_details.length > 0) {
    return session.active_agent_details
      .filter((agent) => agent && typeof agent === "object" && typeof agent.display_name === "string")
      .map((agent) => formatAgent(agent.display_name, theme))
  }
  const agents = Array.isArray(session?.active_agents) ? session.active_agents : []
  return uniqueStrings(agents).map((agent) => formatAgent(agent, theme))
}

function summarizeState(state) {
  const sessions = Array.isArray(state?.sessions) ? state.sessions.filter((session) => isProcessAlive(session?.pid)) : []
  const config = state?.config && typeof state.config === "object" ? state.config : {}
  const theme = normalizeTheme(config.agentNameTheme)
  const statuses = sessions.map((session) => (typeof session?.status === "string" ? session.status : "idle"))
  const status = statuses.includes("waiting-input") ? "waiting-input" : statuses.includes("busy") ? "busy" : "idle"
  const activeAgentDetails = sessions.flatMap((session) => sessionAgentDetails(session, theme)).filter(isVisibleAgent)
  const fallbackAgent = formatAgent(status === "waiting-input" ? "input" : status === "busy" ? "orchestrator" : "intro", theme)
  const displayAgentDetails = dedupeAgents(activeAgentDetails)
  const visibleAgentDetails = buildVisibleAgentDetails(status, fallbackAgent, displayAgentDetails, theme)

  return {
    version: VERSION,
    launcher_session_id: launcherSessionID,
    started_at: startedAt,
    observed_at: new Date().toISOString(),
    state_path: statePath,
    status,
    active_agents: visibleAgentDetails.map((agent) => agent.display_name),
    active_agent_details: visibleAgentDetails,
    session_count: sessions.length,
    sessions: sessions.map((session) => ({
      session_id: typeof session?.session_id === "string" ? session.session_id : "unknown",
      cwd: typeof session?.cwd === "string" ? session.cwd : "",
      status: typeof session?.status === "string" ? session.status : "idle",
      active_agents: sessionAgentDetails(session, theme).map((agent) => agent.display_name),
      active_agent_details: sessionAgentDetails(session, theme),
      updated_at: typeof session?.updated_at === "string" ? session.updated_at : null,
    })),
    config: {
      enabled: config.enabled === true,
      position: typeof config.position === "string" ? config.position : "bottom-right",
      size: typeof config.size === "string" ? config.size : "medium",
      gifPack: typeof config.gifPack === "string" ? config.gifPack : "default",
      loopStyle: typeof config.loopStyle === "string" ? config.loopStyle : "classic",
      speed: typeof config.speed === "number" ? config.speed : 1,
      debug: config.debug === true,
      agentNameTheme: theme,
      artBasePath,
    },
  }
}

function isVisibleAgent(agent) {
  const name = typeof agent?.display_name === "string" ? agent.display_name : ""
  return name.length > 0 && name !== "intro"
}

function buildVisibleAgentDetails(status, fallbackAgent, activeAgentDetails, theme) {
  if (status === "waiting-input") return dedupeAgents([formatAgent("input", theme), ...activeAgentDetails])
  if (activeAgentDetails.length > 0) return activeAgentDetails
  return [fallbackAgent]
}

function dedupeAgents(agents) {
  const seen = new Set()
  const result = []
  for (const agent of agents) {
    const key = typeof agent?.display_name === "string" && agent.display_name.trim().length > 0 ? agent.display_name.trim() : agent?.art_key
    if (!key || seen.has(key)) continue
    seen.add(key)
    result.push(agent)
  }
  return result
}

function writeJsonAtomic(filePath, value) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true })
  const tempPath = `${filePath}.${process.pid}.${Date.now()}.tmp`
  fs.writeFileSync(tempPath, `${JSON.stringify(value, null, 2)}\n`)
  fs.renameSync(tempPath, filePath)
}

function maybeNotify(summary) {
  if (!debugEnabled || os.platform() !== "darwin" || notificationInFlight || summary.status === lastStatus) return
  lastStatus = summary.status
  const title = "Fellowship Companion"
  const message = `${summary.status}: ${summary.active_agents.join(", ")}`.replace(/"/g, "'")
  notificationInFlight = true
  const child = spawn("osascript", ["-e", `display notification "${message}" with title "${title}"`], {
    detached: true,
    stdio: "ignore",
  })
  child.once("error", (err) => appendLog(`notification failed: ${err.message}`))
  child.once("exit", () => {
    notificationInFlight = false
  })
  child.unref()
}

function readPid(filePath) {
  try {
    const raw = fs.readFileSync(filePath, "utf8").trim()
    const pid = Number(raw)
    return Number.isInteger(pid) && pid > 0 ? pid : null
  } catch (_err) {
    return null
  }
}

function isProcessAlive(pid) {
  try {
    process.kill(pid, 0)
    return true
  } catch (_err) {
    return false
  }
}

function maybeLaunchOverlay(summary) {
  if (overlayDisabled || os.platform() !== "darwin" || !summary.config.enabled || summary.status === "idle" || !fs.existsSync(overlayPath)) return
  if (overlayProcess && overlayProcess.exitCode === null && !overlayProcess.killed) return

  const existingOverlayPid = readPid(overlayPidPath)
  if (existingOverlayPid && isProcessAlive(existingOverlayPid)) return
  if (existingOverlayPid) fs.rmSync(overlayPidPath, { force: true })

  const now = Date.now()
  if (now - lastOverlayLaunchAt < 5000) return
  lastOverlayLaunchAt = now

  overlayProcess = spawn("osascript", ["-l", "JavaScript", overlayPath, overlayProcessName, statePath, logPath], {
    argv0: overlayProcessName,
    detached: true,
    stdio: "ignore",
  })
  overlayProcess.once("error", (err) => appendLog(`overlay failed: ${err.message}`))
  overlayProcess.once("exit", (code, signal) => {
    appendLog(`overlay exited code=${code ?? "null"} signal=${signal ?? "null"}`)
    fs.rmSync(overlayPidPath, { force: true })
    overlayProcess = null
  })
  overlayProcess.unref()
  if (overlayProcess.pid) fs.writeFileSync(overlayPidPath, `${overlayProcess.pid}\n`)
  appendLog(`overlay launched pid=${overlayProcess.pid ?? "unknown"}`)
}

function pollIntervalMs(summary) {
  const speed = typeof summary.config.speed === "number" && Number.isFinite(summary.config.speed) ? summary.config.speed : 1
  return Math.max(MIN_POLL_MS, Math.min(MAX_POLL_MS, Math.round(DEFAULT_POLL_MS / speed)))
}

function tick() {
  const state = readJson(statePath) || { version: VERSION, sessions: [], config: { enabled: false } }
  const summary = summarizeState(state)
  try {
    writeJsonAtomic(runtimePath, summary)
    const key = JSON.stringify({ status: summary.status, agents: summary.active_agents, sessions: summary.session_count })
    if (key !== lastSummaryKey) {
      appendLog(`status=${summary.status} sessions=${summary.session_count} agents=${summary.active_agents.join(",")}`)
      lastSummaryKey = key
    }
    maybeNotify(summary)
    maybeLaunchOverlay(summary)
    if (summary.status === "idle" && overlayProcess && !overlayProcess.killed) overlayProcess.kill()
  } catch (err) {
    appendLog(`write failed: ${err instanceof Error ? err.message : String(err)}`)
  }
  return pollIntervalMs(summary)
}

function scheduleNext() {
  const delay = tick()
  setTimeout(scheduleNext, delay).unref()
}

process.on("uncaughtException", (err) => appendLog(`uncaught exception: ${err instanceof Error ? err.stack ?? err.message : String(err)}`))
process.on("unhandledRejection", (err) => appendLog(`unhandled rejection: ${err instanceof Error ? err.stack ?? err.message : String(err)}`))
process.on("SIGTERM", () => {
  appendLog("received SIGTERM")
  if (overlayProcess && !overlayProcess.killed) overlayProcess.kill()
  process.exit(0)
})
process.on("SIGINT", () => {
  appendLog("received SIGINT")
  if (overlayProcess && !overlayProcess.killed) overlayProcess.kill()
  process.exit(0)
})

appendLog(`started pid=${process.pid} state=${statePath}`)
scheduleNext()
setInterval(() => {}, 2147483647)
